<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>
  <groupId>org.octavio</groupId>
  <artifactId>payment-reconciliation-sim</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>payment-reconciliation-sim</name>
  <description>Payment reconciliation simulator</description>
  <modules>
    <module>reconciliation-api</module>
    <module>reconciliation-worker</module>
    <module>scenario-generator</module>
    <module>acceptance-tests</module>
  </modules>
  <properties>
    <java.version>21</java.version>
    <tests.unit.skip>false</tests.unit.skip>
    <tests.acceptance.skip>false</tests.acceptance.skip>
    <quality.skip>false</quality.skip>
    <mutation.skip>false</mutation.skip>
    <mutation.threshold>80</mutation.threshold>
    <tests.failIfNoTests>true</tests.failIfNoTests>
    <mutation.failWhenNoMutations>true</mutation.failWhenNoMutations>
    <mode.all>false</mode.all>
    <mode.unit>false</mode.unit>
    <mode.acceptance>false</mode.acceptance>
    <mode.mutation>false</mode.mutation>
    <build.mode.signature>${mode.all},${mode.unit},${mode.acceptance},${mode.mutation}</build.mode.signature>
    <argLine/>
    <cucumber.version>8.0.4</cucumber.version>
    <wiremock.version>3.13.2</wiremock.version>
    <jacoco.version>0.8.15</jacoco.version>
    <pitest.version>1.30.0</pitest.version>
    <pitest-junit5.version>1.2.3</pitest-junit5.version>
    <aws-sdk.version>2.55.11</aws-sdk.version>
    <commons-csv.version>1.14.1</commons-csv.version>
    <maven-enforcer.version>3.6.3</maven-enforcer.version>
    <maven-shade.version>3.6.2</maven-shade.version>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.cucumber</groupId><artifactId>cucumber-bom</artifactId>
        <version>${cucumber.version}</version><type>pom</type><scope>import</scope>
      </dependency>
      <dependency>
        <groupId>software.amazon.awssdk</groupId><artifactId>bom</artifactId>
        <version>${aws-sdk.version}</version><type>pom</type><scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.wiremock</groupId><artifactId>wiremock</artifactId><version>${wiremock.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId><artifactId>commons-csv</artifactId><version>${commons-csv.version}</version>
      </dependency>
      <dependency>
        <groupId>org.octavio</groupId><artifactId>reconciliation-api</artifactId><version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.octavio</groupId><artifactId>reconciliation-worker</artifactId><version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.octavio</groupId><artifactId>scenario-generator</artifactId><version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <skipTests>${tests.unit.skip}</skipTests>
            <failIfNoTests>${tests.failIfNoTests}</failIfNoTests>
            <argLine>@{argLine}</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId>
          <configuration>
            <skipTests>${tests.acceptance.skip}</skipTests>
            <failIfNoTests>true</failIfNoTests>
            <includes><include>**/*IT.java</include></includes>
          </configuration>
          <executions><execution><id>default</id><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId><version>${jacoco.version}</version>
          <configuration>
            <skip>${quality.skip}</skip>
            <!-- Only runtime entrypoints are outside handwritten domain coverage. -->
            <excludes>
              <exclude>**/PaymentReconciliationSimApplication.class</exclude>
              <exclude>**/ScenarioGeneratorMain.class</exclude>
            </excludes>
            <rules><rule><element>BUNDLE</element><limits>
              <limit><counter>LINE</counter><value>MISSEDCOUNT</value><maximum>0</maximum></limit>
              <limit><counter>BRANCH</counter><value>MISSEDCOUNT</value><maximum>0</maximum></limit>
            </limits></rule></rules>
          </configuration>
          <executions>
            <execution><id>unit-coverage</id><goals><goal>prepare-agent</goal></goals></execution>
            <execution><id>coverage-gate</id><phase>verify</phase><goals><goal>report</goal><goal>check</goal></goals></execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.pitest</groupId><artifactId>pitest-maven</artifactId><version>${pitest.version}</version>
          <dependencies><dependency><groupId>org.pitest</groupId><artifactId>pitest-junit5-plugin</artifactId><version>${pitest-junit5.version}</version></dependency></dependencies>
          <configuration>
            <skip>${mutation.skip}</skip>
            <mutationThreshold>${mutation.threshold}</mutationThreshold>
            <failWhenNoMutations>${mutation.failWhenNoMutations}</failWhenNoMutations>
            <excludedClasses>
              <param>org.octavio.paymentreconciliationsim.PaymentReconciliationSimApplication</param>
              <param>org.octavio.paymentreconciliationsim.generator.ScenarioGeneratorMain</param>
            </excludedClasses>
            <outputFormats><param>XML</param><param>HTML</param></outputFormats>
            <timestampedReports>false</timestampedReports>
          </configuration>
          <executions><execution><id>mutation-gate</id><phase>verify</phase><goals><goal>mutationCoverage</goal></goals></execution></executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>${maven-shade.version}</version>
          <configuration><createDependencyReducedPom>false</createDependencyReducedPom><shadedArtifactAttached>true</shadedArtifactAttached></configuration>
          <executions><!-- Boot supplies a Spring-specific default execution; these standalone JARs use their own transformers. --><execution><id>default</id><phase>none</phase></execution><execution><id>deployable-jar</id><phase>package</phase><goals><goal>shade</goal></goals></execution></executions>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId><version>${maven-enforcer.version}</version>
        <executions><execution><id>select-one-test-mode</id><goals><goal>enforce</goal></goals>
          <configuration><rules><requireProperty>
            <property>build.mode.signature</property>
            <regex>false,false,false,false|true,false,false,false|false,true,false,false|false,false,true,false|false,false,false,true</regex>
            <regexMessage>Select at most one test mode profile: all-tests, unit-tests, acceptance-tests, mutation-tests.</regexMessage>
          </requireProperty></rules></configuration>
        </execution></executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile><id>all-tests</id><properties><mode.all>true</mode.all></properties></profile>
    <profile><id>unit-tests</id><properties>
      <mode.unit>true</mode.unit><tests.acceptance.skip>true</tests.acceptance.skip><mutation.skip>true</mutation.skip>
    </properties></profile>
    <profile><id>acceptance-tests</id><properties>
      <mode.acceptance>true</mode.acceptance><tests.unit.skip>true</tests.unit.skip><quality.skip>true</quality.skip><mutation.skip>true</mutation.skip>
    </properties></profile>
    <profile><id>mutation-tests</id><properties>
      <mode.mutation>true</mode.mutation><tests.acceptance.skip>true</tests.acceptance.skip>
    </properties></profile>
    <profile><id>skip-all-test-execution</id><activation><property><name>skipTests</name><value>true</value></property></activation><properties>
      <tests.unit.skip>true</tests.unit.skip><tests.acceptance.skip>true</tests.acceptance.skip><quality.skip>true</quality.skip><mutation.skip>true</mutation.skip>
    </properties></profile>
    <profile><id>skip-all-test-compilation</id><activation><property><name>maven.test.skip</name><value>true</value></property></activation><properties>
      <tests.unit.skip>true</tests.unit.skip><tests.acceptance.skip>true</tests.acceptance.skip><quality.skip>true</quality.skip><mutation.skip>true</mutation.skip>
    </properties></profile>
  </profiles>
</project>
